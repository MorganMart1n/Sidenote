<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox fx:id="mainRoot" alignment="TOP_LEFT" spacing="10.0" styleClass="main" stylesheets="@noteList.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.noteViewController">
    
    <padding>
        <Insets bottom="20" left="20" right="20" top="10" />
    </padding>

    <children>
        <HBox fx:id="titleBar" alignment="CENTER_LEFT" maxHeight="60.0" minHeight="50.0" spacing="5.0" styleClass="title-bar">
            <children>
                <Button fx:id="listBtn" focusTraversable="false" onAction="#switchToNoteList" styleClass="icon-button" text="≡" />
                <Button fx:id="dockBtn" focusTraversable="false" onAction="#apearOnTop" styleClass="icon-button" text="🔒" />

                <VBox fx:id="slideContainer" alignment="CENTER_LEFT">
                    <children>
                        <Button id="textSylers" onAction="#handleSlider">
                            <graphic>
                                <ImageView fitHeight="25" fitWidth="25">
                                    <image><Image url="@images/textSize.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <VBox fx:id="slider" />
                    </children>
                </VBox>

                <Button id="textSylers" onAction="#handleBold" text="B" style="-fx-font-weight: bold;"/>
                
                <Region HBox.hgrow="ALWAYS" />

                <Button focusTraversable="false" onAction="#minimizeWindow" text="—" />
                <Button fx:id="closeButton" focusTraversable="false" onAction="#closeWindow" text="✕" />
            </children>
        </HBox>

        <TextField fx:id="titleField" promptText="Note Title">
            <VBox.margin>
                <Insets left="5.0" right="5.0" />
            </VBox.margin>
        </TextField>

        <VBox fx:id="editorContainer" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </VBox.margin>
        </VBox>
    </children>
</VBox>