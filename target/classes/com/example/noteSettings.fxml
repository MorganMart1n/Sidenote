<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Label?>

<VBox fx:id="mainRoot" alignment="TOP_LEFT" spacing="10.0"
      snapToPixel="true"
      styleClass="main"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.noteSettingController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="10"/>
    </padding>

   <VBox fx:id="titleBar" alignment="CENTER_LEFT" prefHeight="40.0" minHeight="40.0" maxHeight="40.0" spacing="5.0" styleClass="title-bar">
    <children>
        <HBox spacing="5.0" alignment="CENTER_LEFT"> <Button fx:id="listBtn" text="≡" onAction="#switchToNoteList" styleClass="icon-button"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#minimizeWindow" text="—" />
            <Button fx:id="closeButton" onAction="#closeWindow" text="✕" />
        </HBox>
    </children>
</VBox>

<ScrollPane fitToHeight="true"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            VBox.vgrow="ALWAYS"
            style="-fx-background-color: transparent;">

    <content>

        <VBox fx:id="settingsContainer"
              alignment="TOP_CENTER"
              spacing="20">

            <!-- Appearance -->
            <VBox spacing="8"
                  alignment="CENTER_LEFT"
                  styleClass="settings-group">

                <Label text="Appearance"
                       styleClass="settings-title"/>

                <Label text="Choose application theme"
                       styleClass="settings-subtitle"/>
            
                <MenuButton fx:id="themeMenu"
                            text="Cyberpunk"
                            styleClass="theme-dropdown">

                    <items>
                    <!--Add more themes here-->
                    <MenuItem text="Default"
                                  onAction="#switchToDefault"/>
                        <MenuItem text="Cyberpunk Blue"
                                  onAction="#switchToCyberpunkBlue"/>
                   
                    <MenuItem text="Cyberpunk Red"
                                  onAction="#switchToCyberpunkRed"/>
                    </items>

                </MenuButton>

            </VBox>

           

        </VBox>

    </content>

</ScrollPane>

</VBox>