<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<VBox fx:id="mainRoot" alignment="TOP_LEFT" spacing="10.0" 
      snapToPixel="true"
      minWidth="-Infinity" 
      minHeight="-Infinity"
      styleClass="main"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.example.noteListController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="10" />
    </padding>

    <children>
<HBox fx:id="titleBar" 
      alignment="CENTER_LEFT" 
      prefHeight="40.0" minHeight="40.0" maxHeight="40.0" 
      spacing="5.0" 
      styleClass="title-bar">
    <VBox.margin>
        <Insets left="5.0" right="5.0" top="5.0" />
    </VBox.margin>
    <children>
        <Button onAction="#createNewNoteSwitch" focusTraversable="false" styleClass="icon-button">
            <graphic>
                <ImageView fitHeight="16" fitWidth="16" pickOnBounds="true" preserveRatio="true">
                    <Image url="@images/plus.png" />
                </ImageView>
            </graphic>
        </Button>
        
        <Button fx:id="dockBtn" focusTraversable="false" onAction="#apearOnTop" styleClass="icon-button">
                <graphic>
                        <ImageView fitHeight="22" fitWidth="22" preserveRatio="true" smooth="true">
                         <image>
                        <Image url="@images/lock.png" /> </image>
                    </ImageView>
                </graphic>
        </Button>
        <Button fx:id="" focusTraversable="false" onAction="#noteSettings" styleClass="icon-button">
                <graphic>
                        <ImageView fitHeight="22" fitWidth="22" preserveRatio="true" smooth="true">
                         <image>
                        <Image url="@images/cog.png" /> </image>
                    </ImageView>
                </graphic>
        </Button>

        <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />

        <Button onAction="#minimizeWindow" text="—" focusTraversable="false" />
        <Button fx:id="closeButton" onAction="#closeWindow" text="✕" focusTraversable="false" />
    </children>
</HBox>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-padding: 0 5 0 0;">
            <content>
                <VBox fx:id="noteContainer" alignment="TOP_CENTER" spacing="12.0" 
                      style="-fx-background-color: transparent;" snapToPixel="true" />
            </content>
        </ScrollPane>
    </children>
</VBox>